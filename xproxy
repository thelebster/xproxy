#!/usr/bin/env python3
"""xproxy: several local xray proxies, each on its own port with its own VLESS subscription.

All proxies run in the Homebrew xray service. The proxy list lives in
~/.config/xproxy/proxies.json; after every change the whole xray config
($(brew --prefix)/etc/xray/config.json) is generated from it, validated with
`xray run -test`, backed up, xray is restarted and the changed proxies are
checked end-to-end. A failed check restores the previous config (`apply` and
`import` keep the new one and report the dead proxies).

Each proxy gets SOCKS on <port> and HTTP on <port>+1, routed to its own outbound.

Run `xproxy` (or `xproxy <command> -h`) for the commands; see README.md for details.
"""

import argparse
import base64
import concurrent.futures
import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

STATE_DIR = os.path.expanduser("~/.config/xproxy")
STATE_PATH = os.path.join(STATE_DIR, "proxies.json")
SUBS_DIR = os.path.join(STATE_DIR, "subs")
USER_AGENT = "v2rayN"
TEST_URL = "https://www.google.com"
# Two-letter exit country code, e.g. "HU". Not ifconfig.co: its GeoIP data is wrong for some
# provider exit ranges (a Budapest exit showed as Brazil or France there).
COUNTRY_URL = "https://ipinfo.io/country"
BACKUP_KEEP = 5


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def xray_dir():
    prefix = subprocess.run(["brew", "--prefix"], capture_output=True, text=True, check=True).stdout.strip()
    return os.path.join(prefix, "etc/xray")


def config_path():
    return os.path.join(xray_dir(), "config.json")


def write_private(path, text):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(path, 0o600)


# --- state -------------------------------------------------------------------

def load_state():
    if not os.path.exists(STATE_PATH):
        return {"proxies": {}}
    with open(STATE_PATH) as f:
        return json.load(f)


def save_state(state):
    write_private(STATE_PATH, json.dumps(state, indent=2, ensure_ascii=False) + "\n")


def get_proxy(state, name):
    if name not in state["proxies"]:
        die(f"no proxy {name!r}; see `xproxy ls`")
    return state["proxies"][name]


def http_port(p):
    return p["port"] + 1


def label(server):
    return f"{server['name']} ({server['address']}:{server['port']})"


# --- subscriptions -----------------------------------------------------------

def decode_links(body):
    body = body.strip()
    if "://" not in body:
        body = body.translate(str.maketrans("-_", "+/"))  # URL-safe base64 too
        body = base64.b64decode(body + "=" * (-len(body) % 4)).decode()
    return [line.strip() for line in body.splitlines() if line.startswith("vless://")]


def parse_vless(link):
    u = urllib.parse.urlsplit(link)
    q = {k: v[0] for k, v in urllib.parse.parse_qs(u.query).items()}
    # Some providers put "<uuid>@<host>#<label>" in the fragment; keep the label.
    name = urllib.parse.unquote(u.fragment).rpartition("#")[2]
    return {
        "name": name or u.hostname,
        "id": urllib.parse.unquote(u.username or ""),
        "address": u.hostname,
        "port": u.port or 443,
        "q": q,
    }


def same_server(a, b):
    return all(a[k] == b[k] for k in ("address", "port", "id")) and a["q"].get("sni") == b["q"].get("sni")


def http_get(url, proxy=None, timeout=20):
    """(status, body) of GET url, optionally through a local HTTP proxy; env proxies are ignored."""
    handler = urllib.request.ProxyHandler({"http": proxy, "https": proxy} if proxy else {})
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.build_opener(handler).open(req, timeout=timeout) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as e:
        return e.code, b""


def cache_path(name):
    return os.path.join(SUBS_DIR, f"{name}.txt")


def fetch(state, name):
    """Fetch the subscription directly, else through each enabled proxy; cache it."""
    url = get_proxy(state, name).get("url") or die(f"{name} has no subscription URL; set it with `xproxy url`")
    vias = [None] + [f"http://127.0.0.1:{http_port(p)}" for p in state["proxies"].values()
            if p["enabled"] and p["server"]]  # a proxy being added has no server yet
    errors = []
    for via in vias:
        try:
            status, body = http_get(url, via)
            links = decode_links(body.decode()) if status == 200 else []
        except Exception as e:
            errors.append(f"{via or 'direct'}: {e}")
            continue
        if links:
            write_private(cache_path(name), "\n".join(links) + "\n")
            print(f"Fetched {len(links)} servers" + (f" via {via}" if via else ""))
            return
        errors.append(f"{via or 'direct'}: " + (f"HTTP {status}" if status != 200 else "no vless:// links"))
    reasons = "".join(f"\n  {e}" for e in errors)
    if os.path.exists(cache_path(name)):
        print(f"warning: fetching the subscription failed; using the cached list{reasons}", file=sys.stderr)
    else:
        die(f"fetching the subscription failed, directly and through every proxy{reasons}")


def load_servers(state, name, refresh=False):
    if refresh or not os.path.exists(cache_path(name)):
        fetch(state, name)
    with open(cache_path(name)) as f:
        servers = [parse_vless(link) for link in decode_links(f.read())]
    return servers or die(f"no vless:// links in the {name} subscription")


def choose(servers, current=None, choice=None):
    if choice is None and len(servers) == 1:
        return servers[0]
    if choice is None:
        for i, s in enumerate(servers, 1):
            mark = "*" if current and same_server(s, current) else " "
            print(f"{i:3}{mark} {s['address']:>15}:{s['port']:<5}  {s['name']}")
    while True:
        answer = choice if choice is not None else input(f"\nServer [1-{len(servers)}]: ").strip()
        if str(answer).isdigit() and 1 <= int(answer) <= len(servers):
            return servers[int(answer) - 1]
        if choice is not None:
            die(f"server number must be 1-{len(servers)}")


# --- xray config -------------------------------------------------------------

def build_outbound(server, tag):
    q = server["q"]
    security = q.get("security", "none")
    network = q.get("type", "tcp")
    if security != "reality" or network != "tcp":
        raise ValueError(f"unsupported entry (security={security}, type={network}); only reality over tcp is handled")

    user = {"id": server["id"], "encryption": q.get("encryption", "none")}
    if q.get("flow"):
        user["flow"] = q["flow"]
    reality = {
        "serverName": q.get("sni", ""),
        "publicKey": q.get("pbk", ""),
        "shortId": q.get("sid", ""),
        "fingerprint": q.get("fp", "chrome"),
    }
    if q.get("spx"):
        reality["spiderX"] = q["spx"]
    return {
        "tag": tag,
        "protocol": "vless",
        "settings": {"vnext": [{"address": server["address"], "port": server["port"], "users": [user]}]},
        "streamSettings": {"network": network, "security": security, "realitySettings": reality},
    }


def inbounds(name, socks_port, http_port_):
    return [
        {"tag": f"{name}-socks", "listen": "127.0.0.1", "port": socks_port, "protocol": "socks",
         "settings": {"udp": True}, "sniffing": {"enabled": True, "destOverride": ["http", "tls"]}},
        {"tag": f"{name}-http", "listen": "127.0.0.1", "port": http_port_, "protocol": "http"},
    ]


def build_config(state):
    config = {"log": {"loglevel": "warning"}, "inbounds": [], "outbounds": [], "routing": {"rules": []}}
    for name, p in state["proxies"].items():
        if not p["enabled"]:
            continue
        try:
            config["outbounds"].append(build_outbound(p["server"], name))
        except ValueError as e:
            die(f"{name}: {e}")
        config["inbounds"] += inbounds(name, p["port"], http_port(p))
        config["routing"]["rules"].append(
            {"type": "field", "inboundTag": [f"{name}-socks", f"{name}-http"], "outboundTag": name})
    return config


def prune_backups(path):
    directory, base = os.path.split(path)
    backups = sorted(f for f in os.listdir(directory) if f.startswith(f"{base}.bak-"))
    for old in backups[:-BACKUP_KEEP]:
        os.unlink(os.path.join(directory, old))


def brew_services(action):
    r = subprocess.run(["brew", "services", action, "xray"], capture_output=True, text=True)
    if r.returncode != 0:
        die(f"brew services {action} xray failed:\n{r.stdout}{r.stderr}")


def check(port, country=True, timeout=15):
    """(ok, seconds, exit country) through a local HTTP proxy port."""
    proxy = f"http://127.0.0.1:{port}"
    start = time.monotonic()
    try:
        http_get(TEST_URL, proxy, timeout=timeout)
    except Exception:
        return False, 0.0, ""
    secs = time.monotonic() - start
    if not country:
        return True, secs, ""
    try:
        country = http_get(COUNTRY_URL, proxy, timeout=10)[1].decode().strip()
    except Exception:
        country = ""
    return True, secs, country


def wait_listening(port, timeout=5, proc=None):
    """True once something accepts connections on the local port (gives up early if `proc` exits)."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline and not (proc and proc.poll() is not None):
        try:
            socket.create_connection(("127.0.0.1", port), timeout=1).close()
            return True
        except OSError:
            time.sleep(0.2)
    return False


def check_after_start(port):
    """check() on a freshly started xray: wait for it to listen, give a slow request a second try."""
    if not wait_listening(port):
        return False, 0.0, ""
    result = check(port)
    if not result[0]:
        time.sleep(2)
        result = check(port)
    return result


def apply(state, check_names=(), rollback=True):
    """Write the xray config for `state`, restart, check; on success save `state`.

    A failed check restores the previous config (rollback=True) or keeps the new one,
    saves `state` and reports the dead proxies (rollback=False, or no previous config).
    """
    config = build_config(state)
    xray = shutil.which("xray") or die("xray not found in PATH (brew install xray)")
    path = config_path()

    fd, tmp = tempfile.mkstemp(suffix=".json", dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as f:
        json.dump(config, f, indent=2, ensure_ascii=False)
    if config["outbounds"]:
        test = subprocess.run([xray, "run", "-test", "-config", tmp], capture_output=True, text=True)
        if test.returncode != 0:
            os.unlink(tmp)
            die(f"xray rejected the generated config:\n{test.stdout}{test.stderr}")

    backup = None
    if os.path.exists(path):
        backup = f"{path}.bak-{time.strftime('%Y%m%d-%H%M%S')}"
        shutil.copy2(path, backup)
        shutil.copymode(path, tmp)
    else:
        os.chmod(tmp, 0o644)
    shutil.move(tmp, path)
    prune_backups(path)

    if not config["outbounds"]:
        brew_services("stop")
        save_state(state)
        print("No enabled proxies; xray stopped")
        return
    brew_services("restart")

    failed = []
    for name in check_names:
        ok, secs, country = check_after_start(http_port(state["proxies"][name]))
        if ok:
            print(f"OK: {name} -> {secs:.1f}s, exit {country or 'unknown'}")
        else:
            failed.append(name)
    if failed and rollback and backup:
        shutil.copy2(backup, path)
        brew_services("restart")
        die(f"{', '.join(failed)}: no traffic through the new server; previous config restored")
    save_state(state)
    if failed:
        die(f"{', '.join(failed)}: no traffic; config applied anyway, switch with `xproxy pick <name>`")


# --- commands ----------------------------------------------------------------

def cmd_add(state, args):
    if args.name in state["proxies"]:
        die(f"{args.name} already exists")
    used = {port for p in state["proxies"].values() for port in (p["port"], http_port(p))}
    if {args.port, args.port + 1} & used:
        die(f"port {args.port} or {args.port + 1} is used by another proxy")
    state["proxies"][args.name] = {"port": args.port, "url": args.url, "enabled": True, "server": None}
    server = choose(load_servers(state, args.name, refresh=True))
    state["proxies"][args.name]["server"] = server
    print(f"{args.name} -> {label(server)}")
    apply(state, [args.name])


def cmd_pick(state, args):
    p = get_proxy(state, args.name)
    server = choose(load_servers(state, args.name, args.refresh), p["server"], args.n)
    p["server"] = server
    p["enabled"] = True
    print(f"{args.name} -> {label(server)}")
    apply(state, [args.name])


def cmd_up(state, args):
    get_proxy(state, args.name)["enabled"] = True
    apply(state, [args.name])


def cmd_down(state, args):
    get_proxy(state, args.name)["enabled"] = False
    apply(state)
    print(f"{args.name} down")


def cmd_rm(state, args):
    get_proxy(state, args.name)
    del state["proxies"][args.name]
    apply(state)
    if os.path.exists(cache_path(args.name)):
        os.unlink(cache_path(args.name))
    print(f"{args.name} removed")


def cmd_url(state, args):
    get_proxy(state, args.name)["url"] = args.url
    save_state(state)
    fetch(state, args.name)


def cmd_apply(state, args):
    apply(state, [n for n, p in state["proxies"].items() if p["enabled"]], rollback=False)


def cmd_ls(state, args):
    if not state["proxies"]:
        print("No proxies; add one with `xproxy add` or `xproxy import`")
        return
    names = list(state["proxies"])
    with concurrent.futures.ThreadPoolExecutor(len(names)) as pool:
        # None for disabled proxies, else check()'s (ok, seconds, country).
        results = list(pool.map(lambda n: check(http_port(state["proxies"][n])) if state["proxies"][n]["enabled"] else None,
                                names))
    print(f"{'NAME':8} {'PORTS':12} {'STATUS':7} {'TIME':>5}  {'EXIT':4} SERVER")
    for name, result in zip(names, results):
        p = state["proxies"][name]
        if result is None:
            status, secs, country = "down", "", ""
        elif result[0]:
            status, secs, country = "up", f"{result[1]:.1f}s", result[2]
        else:
            status, secs, country = "dead", "", ""
        print(f"{name:8} {p['port']}/{http_port(p):<6} {status:7} {secs:>5}  {country:4} {label(p['server'])}")


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def probe_one(xray, workdir, i, server, country):
    try:
        outbound = build_outbound(server, "proxy")
    except ValueError:
        return "unsupported", 0.0, ""
    port = free_port()
    config = {"log": {"loglevel": "none"},
              "inbounds": [{"listen": "127.0.0.1", "port": port, "protocol": "http"}],
              "outbounds": [outbound]}
    path = os.path.join(workdir, f"{i}.json")
    with open(path, "w") as f:
        json.dump(config, f)
    proc = subprocess.Popen([xray, "run", "-config", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        if not wait_listening(port, proc=proc) or proc.poll() is not None:
            return "error", 0.0, ""  # xray did not start, or something else holds the port
        ok, secs, exit_country = check(port, country, timeout=10)
    finally:
        proc.kill()
        proc.wait()
    return ("ok" if ok else "dead"), secs, exit_country


def cmd_probe(state, args):
    p = get_proxy(state, args.name)
    servers = load_servers(state, args.name, args.refresh)
    xray = shutil.which("xray") or die("xray not found in PATH (brew install xray)")
    with tempfile.TemporaryDirectory() as workdir:
        pool = concurrent.futures.ThreadPoolExecutor(10)
        try:
            results = pool.map(lambda item: probe_one(xray, workdir, *item, args.country), enumerate(servers))
            working = 0
            for i, (server, (status, secs, country)) in enumerate(zip(servers, results), 1):
                working += status == "ok"
                mark = "*" if p["server"] and same_server(server, p["server"]) else " "
                timing = f"{secs:5.1f}s" if status == "ok" else f"{status:>6}"
                print(f"{i:3}{mark} {timing}  {server['address']:>15}  {server['name']}"
                      + (f"  -> {country}" if country else ""))
        finally:
            # Drop the queued servers; Ctrl-C already reached the running xray children.
            pool.shutdown(cancel_futures=True)
    print(f"\n{working}/{len(servers)} working; switch with `xproxy pick {args.name} <n>`")


def outbound_to_server(ob):
    v = ob["settings"]["vnext"][0]
    user = v["users"][0]
    ss = ob.get("streamSettings", {})
    rs = ss.get("realitySettings", {})
    q = {"security": ss.get("security", "none"), "type": ss.get("network", "tcp"),
         "encryption": user.get("encryption", "none"), "sni": rs.get("serverName", ""),
         "pbk": rs.get("publicKey", ""), "sid": rs.get("shortId", ""), "fp": rs.get("fingerprint", "chrome")}
    if user.get("flow"):
        q["flow"] = user["flow"]
    if rs.get("spiderX"):
        q["spx"] = rs["spiderX"]
    return {"name": v["address"], "id": user["id"], "address": v["address"], "port": v["port"], "q": q}


def cmd_import(state, args):
    if state["proxies"] and not args.force:
        die(f"{STATE_PATH} already has proxies; use --force to replace them")
    with open(config_path()) as f:
        config = json.load(f)
    outbounds = [ob for ob in config.get("outbounds", []) if ob.get("protocol") == "vless"]
    if not outbounds:
        die("no vless outbounds in the current xray config")
    default = config["outbounds"][0].get("tag")
    routed = {t: r.get("outboundTag") for r in config.get("routing", {}).get("rules", []) for t in r.get("inboundTag", [])}

    state = {"proxies": {}}
    for ob in outbounds:
        name = "main" if ob.get("tag") == default else ob.get("tag")
        mine = [ib for ib in config.get("inbounds", []) if routed.get(ib.get("tag"), default) == ob.get("tag")]
        socks = next((ib["port"] for ib in mine if ib.get("protocol") == "socks"), None)
        if socks is None:
            print(f"skipping {ob.get('tag')}: no SOCKS inbound leads to it", file=sys.stderr)
            continue
        server = outbound_to_server(ob)
        state["proxies"][name] = {"port": socks, "url": None, "enabled": True, "server": server}
        print(f"{name}: {socks}/{socks + 1} -> {label(server)}")
    print("Subscription URLs are unknown; set them with `xproxy url <name> '<url>'` to refresh lists")
    apply(state, list(state["proxies"]), rollback=False)


def main():
    parser = argparse.ArgumentParser(prog="xproxy", description="Several local xray proxies, one per port.")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("add", help="add a proxy and pick its server")
    p.add_argument("name")
    p.add_argument("port", type=int, help="SOCKS port; HTTP is port+1")
    p.add_argument("url", help="VLESS subscription URL")
    p = sub.add_parser("pick", help="switch a proxy to another server")
    p.add_argument("name")
    p.add_argument("n", nargs="?", help="server number (default: ask)")
    p.add_argument("--refresh", action="store_true", help="re-fetch the subscription first")
    for cmd, text in (("up", "enable a proxy"), ("down", "disable a proxy"), ("rm", "delete a proxy")):
        sub.add_parser(cmd, help=text).add_argument("name")
    p = sub.add_parser("url", help="set the subscription URL and fetch it")
    p.add_argument("name")
    p.add_argument("url")
    sub.add_parser("ls", help="list proxies with live status")
    p = sub.add_parser("probe", help="test every server of a proxy's subscription")
    p.add_argument("name")
    p.add_argument("--country", action="store_true", help="also look up each exit country")
    p.add_argument("--refresh", action="store_true", help="re-fetch the subscription first")
    sub.add_parser("apply", help="regenerate the xray config from the proxy list")
    p = sub.add_parser("import", help="create the proxy list from the current xray config")
    p.add_argument("--force", action="store_true", help="replace an existing proxy list")

    args = parser.parse_args(sys.argv[1:] or ["-h"])  # plain `xproxy` prints the full help
    globals()[f"cmd_{args.cmd}"](load_state(), args)  # dispatch to cmd_<name>


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:  # Ctrl-C at a prompt or while waiting on the network: no traceback
        sys.exit(130)
